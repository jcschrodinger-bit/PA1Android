<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REQUERIMIENTO: Permiso explícito para conectar con AlwaysData -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icono_elegance"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icono_elegance"
        android:supportsRtl="true"
        android:theme="@style/Theme.PA1Android">

        <!-- NUEVA: La SplashScreenActivity ahora es la puerta de entrada oficial -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"> <!-- Forzar pantalla completa elegante -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CategoriasActivity" android:exported="false" />

        <!-- MainActivity pasa a ser una actividad interna (Cambiamos exported a false y quitamos el intent-filter) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity android:name=".ProductosActivity" android:exported="false" />
        <activity android:name=".auth.TerminosActivity" android:exported="false" />
        <activity android:name=".ComprasActivity" android:exported="false" />
        <activity android:name=".ProductoDetalleActivity" android:exported="false" />
        <activity android:name=".PerfilActivity" android:exported="false" />
        <activity android:name=".CheckoutSuccessActivity" android:exported="false" />

    </application>

</manifest>